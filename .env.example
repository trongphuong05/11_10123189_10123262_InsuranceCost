# ============================================================
# Copy sang .env rồi chỉnh theo môi trường:
#   cp .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).
# Mọi địa chỉ/cổng đều đọc từ đây — không hardcode localhost trong code.
# ============================================================

# --- Frontend (trình duyệt người dùng) ---
FRONTEND_PORT=80
API_URL=http://localhost:8000
# Khi chạy docker compose, FE proxy /api/* tới backend trong mạng Docker:
BACKEND_INTERNAL_URL=http://backend:8000

# --- Backend ---
BACKEND_PORT=8000
AI_SERVICE_URL=http://ai-service:8001
MONGODB_URI=mongodb://mongodb:27017/insurance
MONGODB_DB=insurance
CORS_ORIGINS=*

# --- AI Service ---
AI_SERVICE_PORT=8001
MODEL_PATH=/app/models/model.joblib
SCHEMA_PATH=/app/models/schema.json
METADATA_PATH=/app/models/metadata.json

# --- Public / tunnel (cập nhật khi đổi ngrok hoặc IP) ---
# Để trống khi chạy local. Khi public, điền URL https://....ngrok-free.app
PUBLIC_APP_URL=
PUBLIC_API_URL=
PUBLIC_AI_URL=
